@page
@model PhanChiThongRazorPages.Pages.Staff.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="card border-0 shadow-sm rounded-0 p-4 bg-white" style="max-width: 600px; margin: 0 auto;">
    <h2 class="fw-bolder mb-4 text-uppercase">My Profile</h2>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success rounded-0">@Model.SuccessMessage</div>
    }

    <form method="post">
        <input type="hidden" asp-for="Account.AccountId" />
        <input type="hidden" asp-for="Account.AccountRole" />
        <div class="mb-3"><label class="fw-semibold">Name</label><input asp-for="Account.AccountName" class="form-control rounded-0" required /></div>
        <div class="mb-3"><label class="fw-semibold">Email</label><input asp-for="Account.AccountEmail" class="form-control rounded-0" required /></div>
        <div class="mb-3"><label class="fw-semibold">Password</label><input asp-for="Account.AccountPassword" type="password" class="form-control rounded-0" placeholder="Leave blank to keep current password" /></div>
        <button type="submit" class="btn btn-dark rounded-0 px-4 w-100 mt-2">Update Profile</button>
    </form>
</div>
