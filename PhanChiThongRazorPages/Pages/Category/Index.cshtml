@page
@model PhanChiThongRazorPages.Pages.Category.IndexModel
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="card border-0 shadow-sm rounded-0 p-4 bg-white">
    <h2 class="fw-bolder mb-4 text-uppercase">Manage Categories</h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-0 shadow-sm" role="alert">
            <strong>Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="get" class="mb-4 d-flex">
        <input type="text" name="SearchQuery" value="@Model.SearchQuery" class="form-control rounded-0 me-2" placeholder="Search by name..." />
        <button type="submit" class="btn btn-dark rounded-0 px-4">Search</button>
    </form>

    <div class="mb-3">
        <button class="btn btn-orange rounded-0 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#categoryModal" onclick="clearForm()">
            Create New Category
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr><th>ID</th><th>Name</th><th>Description</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Categories)
                {
                    <tr>
                        <td>@item.CategoryId</td><td class="fw-semibold">@item.CategoryName</td><td>@item.CategoryDesciption</td>
                        <td>
                            @if(item.IsActive == true) { <span class="badge badge-orange rounded-0">Active</span> }
                            else { <span class="badge bg-secondary rounded-0">Inactive</span> }
                        </td>
                        <td class="text-nowrap">
                            <button class="btn btn-outline-dark btn-sm rounded-0 me-1" onclick="editCat(@item.CategoryId, '@item.CategoryName', '@item.CategoryDesciption', @(item.IsActive==true?"true":"false"))" data-bs-toggle="modal" data-bs-target="#categoryModal">Edit</button>
                            <button class="btn btn-outline-danger btn-sm rounded-0" onclick="showDeleteModal('@item.CategoryId')">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Category Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-0 border-0 shadow">
            <form method="post" asp-page-handler="SaveCategory">
                <div class="modal-header bg-dark text-white rounded-0 border-0">
                    <h5 class="modal-title fw-bold text-uppercase">Category</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="category.CategoryId" id="CategoryId" value="0" />
                    <div class="mb-3"><label class="fw-semibold">Name</label><input type="text" name="category.CategoryName" id="CategoryName" class="form-control rounded-0" required /></div>
                    <div class="mb-3"><label class="fw-semibold">Description</label><input type="text" name="category.CategoryDesciption" id="CategoryDesciption" class="form-control rounded-0" required /></div>
                    <div class="mb-3">
                        <label class="fw-semibold">Status</label>
                        <select name="category.IsActive" id="IsActive" class="form-select rounded-0">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="submit" class="btn btn-dark rounded-0 px-4">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content rounded-0 border-0 shadow">
            <form method="post" asp-page-handler="DeleteCategory">
                <input type="hidden" name="id" id="deleteTargetId" value="" />
                <div class="modal-header bg-danger text-white rounded-0 border-0">
                    <h5 class="modal-title fw-bold text-uppercase" style="font-size: 1rem;"><i class="bi bi-exclamation-triangle"></i> Confirm Delete</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="mb-0">Are you sure you want to delete this item? This action cannot be undone.</p>
                </div>
                <div class="modal-footer border-0 bg-light justify-content-center">
                    <button type="button" class="btn btn-secondary rounded-0 px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-0 px-4">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function clearForm() {
            $('#CategoryId').val('0'); $('#CategoryName').val(''); $('#CategoryDesciption').val(''); $('#IsActive').val('true');
        }
        function editCat(id, name, desc, active) {
            $('#CategoryId').val(id); $('#CategoryName').val(name); $('#CategoryDesciption').val(desc); $('#IsActive').val(active === true || active === 'true' ? 'true' : 'false');
        }
        function showDeleteModal(id) {
            $('#deleteTargetId').val(id);
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }
    </script>
}
