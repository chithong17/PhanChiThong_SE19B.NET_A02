<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FUNews</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <!-- Top Black Header -->
        <div class="bg-black text-white py-3">
            <div class="container d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <a asp-page="/Home" class="text-white text-decoration-none fs-4 fw-bolder me-5">FUNEWS</a>
                    <nav class="d-none d-md-flex gap-4 text-uppercase" style="font-size: 0.8rem; font-weight: 600;">
                        <a asp-page="/Home" class="text-white text-decoration-none">Home</a>
                        @if (Context.Session.GetInt32("Role") == 0) {
                            <a asp-page="/Admin/Dashboard" class="text-white text-decoration-none">Dashboard</a>
                            <a asp-page="/Admin/Index" class="text-white text-decoration-none">Accounts</a>
                            <a asp-page="/Admin/Report" class="text-white text-decoration-none">Report</a>
                        } else if (Context.Session.GetInt32("Role") == 1) {
                            <a asp-page="/Category/Index" class="text-white text-decoration-none">Categories</a>
                            <a asp-page="/NewsArticle/Index" class="text-white text-decoration-none">Articles</a>
                            <a asp-page="/Staff/History" class="text-white text-decoration-none">History</a>
                            <a asp-page="/Staff/Profile" class="text-white text-decoration-none">Profile</a>
                        }
                    </nav>
                </div>
                <div>
                    @if (Context.Session.GetString("Email") != null) {
                        <span class="text-white-50 me-3 text-uppercase" style="font-size: 0.8rem;">@Context.Session.GetString("Email")</span>
                        <a asp-page="/Account/Logout" class="btn btn-sm btn-outline-light rounded-0 fw-bold px-3">LOGOUT</a>
                    } else {
                        <a asp-page="/Account/Login" class="btn btn-sm text-white rounded-0 fw-bold px-4 py-2" style="background-color: var(--accent-orange); border: none;">SUBSCRIBE</a>
                    }
                </div>
            </div>
        </div>
        <!-- Sub White Header -->
        @if (ViewContext.RouteData.Values["page"]?.ToString() == "/Home" || ViewContext.RouteData.Values["page"]?.ToString() == "/AllNews")
        {
            <div class="bg-white py-2 border-bottom shadow-sm">
                <div class="container d-flex justify-content-between align-items-center">
                    <div>
                        <button class="btn btn-sm btn-dark rounded-0 px-2 py-1 fw-bold">☰</button>
                    </div>
                    <div class="fw-bold text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                        GET THE LATEST UPDATES FROM FUNEWS
                    </div>
                    <div>
                        <form method="get" asp-page="/AllNews" class="d-flex m-0">
                            <input type="text" name="query" class="form-control form-control-sm rounded-0 border-end-0" placeholder="Search news..." style="width: 200px;" required>
                            <button type="submit" class="btn btn-sm btn-outline-dark rounded-0 px-3 py-1"><i class="bi bi-search"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </header>
    
    <div class="container flex-grow-1 bg-white p-4 shadow-sm mt-3 mb-5" style="border-radius: 4px;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <h4 class="text-white fw-bolder mb-2">FUNEWS</h4>
                <p class="text-white-50 mb-0" style="font-size: 0.85rem;">Latest Headlines: Breaking News and Updates</p>
            </div>
            <div class="text-end">
                <p class="text-white-50 mb-1" style="font-size: 0.8rem;">SUBSCRIBE To Newsletter</p>
                <div class="d-flex">
                    <input type="email" class="form-control form-control-sm rounded-0 border-0" placeholder="Email address" style="width: 200px;">
                    <button class="btn btn-sm rounded-0 text-white fw-bold" style="background-color: var(--accent-orange);">SUBSCRIBE</button>
                </div>
            </div>
        </div>
        <div class="container mt-5 pt-4 border-top border-secondary text-white-50" style="font-size: 0.85rem;">
            &copy; 2026 FUNewsManagement.
        </div>
    </footer>

    <!-- Global Toast Notification -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
        <div id="liveToast" class="toast align-items-center text-white border-0 shadow-lg rounded-0" style="background-color: #2c2f33 !important; border-left: 4px solid var(--accent-orange) !important; min-width: 450px;" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" style="font-size: 0.95rem;">
                    <strong class="me-2" style="color: var(--accent-orange);"><i class="bi bi-bell-fill"></i> NEW UPDATE:</strong>
                    <span id="toastMessage"></span>
                    <br />
                    <button id="toastActionBtn" class="btn btn-sm rounded-0 mt-2 fw-bold px-3 text-dark" style="background-color: var(--accent-orange); border: none;" onclick="location.reload()">Reload Page to View</button>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Global SignalR Logic -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/newshub")
            .build();

        connection.on("ReceiveNotification", function (message) {
            document.getElementById("toastMessage").innerText = message;
            document.getElementById("toastActionBtn").style.display = "inline-block";
            var toastEl = document.getElementById("liveToast");
            var toast = new bootstrap.Toast(toastEl, { delay: 10000 }); // Show for 10 seconds
            toast.show();
        });

        connection.start().catch(err => console.error(err.toString()));
    </script>
    
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                document.getElementById("toastMessage").innerText = "@TempData["ErrorMessage"]";
                document.getElementById("toastActionBtn").style.display = "none";
                var toastEl = document.getElementById("liveToast");
                var toast = new bootstrap.Toast(toastEl, { delay: 10000 });
                toast.show();
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>